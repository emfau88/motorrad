---
import MediaPlaceholder from "./MediaPlaceholder.astro";

type Props = {
  eyebrow?: string;
  title: string;
  intro: string;
  imageLabel: string;
  imageDescription: string;
};

const { eyebrow, title, intro, imageLabel, imageDescription } = Astro.props;
---

<section class="page-hero" aria-labelledby="page-title">
  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 id="page-title">{title}</h1>
      <p>{intro}</p>
    </div>
    <MediaPlaceholder
      category={imageLabel}
      description={imageDescription}
      aspect="wide"
      tone="dark"
    />
  </div>
</section>

<style>
  .page-hero {
    color: var(--color-text-inverse);
    background: var(--color-ink);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .page-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  h1 {
    max-width: 11ch;
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .page-hero__copy > p:last-child {
    max-width: 39rem;
    margin: 0;
    color: rgb(247 245 239 / 0.72);
  }

  .page-hero :global(.media-placeholder) {
    min-height: 18rem;
  }

  @media (min-width: 60rem) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 0.8fr);
      align-items: stretch;
    }

    .page-hero :global(.media-placeholder) {
      min-height: 25rem;
    }
  }
</style>
