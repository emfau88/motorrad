---
type Props = {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "split";
  level?: "h1" | "h2" | "h3";
};

const { eyebrow, title, intro, align = "left", level = "h2" } = Astro.props;
const Heading = level;
---

<header class:list={["section-heading", `section-heading--${align}`]}>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading>{title}</Heading>
  </div>
  {intro && <p class="section-heading__intro">{intro}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    max-width: 58rem;
    gap: var(--space-4);
  }

  .section-heading--split {
    max-width: none;
  }

  h1,
  h2,
  h3 {
    max-width: 13ch;
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .section-heading__intro {
    max-width: 38rem;
    margin: 0;
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .section-heading--split {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.68fr);
      align-items: end;
      gap: var(--space-6);
    }
  }
</style>
