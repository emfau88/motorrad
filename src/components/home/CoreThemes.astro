---
import MediaPlaceholder from "../MediaPlaceholder.astro";
import SectionHeading from "../SectionHeading.astro";

const themes = [
  {
    number: "01",
    title: "Touren",
    text: "Kurven, Alpen und gemeinsame Kilometer.",
    image: "Ausfahrten und Alpentouren",
    tone: "light" as const,
  },
  {
    number: "02",
    title: "Gemeinschaft",
    text: "Stammtisch, Clubhaus und jede Menge Benzingespräche.",
    image: "Echte Menschen im Vereinsleben",
    tone: "dark" as const,
  },
  {
    number: "03",
    title: "Veranstaltungen",
    text: "Maihock, Motorradausstellungen und besondere Events.",
    image: "Veranstaltungen in Ottenau",
    tone: "light" as const,
  },
];
---

<section class="core-themes section" aria-labelledby="themes-title">
  <div class="container">
    <SectionHeading
      eyebrow="Was uns verbindet"
      title="Motorradfahren ist erst der Anfang."
      intro="Gemeinsame Wege, ein fester Treffpunkt und Veranstaltungen, die Menschen zusammenbringen."
      align="split"
    />
    <div class="core-themes__list">
      {themes.map((theme) => (
        <article class="theme-story">
          <MediaPlaceholder
            category={theme.title}
            description={theme.image}
            tone={theme.tone}
            aspect="wide"
          />
          <div class="theme-story__copy">
            <span aria-hidden="true">{theme.number}</span>
            <div>
              <h3>{theme.title}</h3>
              <p>{theme.text}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .core-themes {
    background: var(--color-paper);
  }

  .core-themes__list {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .theme-story {
    display: grid;
    gap: var(--space-4);
  }

  .theme-story :global(.media-placeholder) {
    min-height: 18rem;
  }

  .theme-story__copy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 0.0625rem solid var(--color-line);
  }

  .theme-story__copy > span {
    color: var(--color-accent);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .theme-story h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .theme-story p {
    max-width: 28rem;
    margin: 0;
    color: var(--color-muted);
  }

  @media (min-width: 58rem) {
    .core-themes__list {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }

    .theme-story:first-child {
      grid-column: 1 / span 5;
    }

    .theme-story:nth-child(2) {
      grid-column: 6 / span 3;
      margin-top: var(--space-7);
    }

    .theme-story:last-child {
      grid-column: 9 / span 4;
      margin-top: var(--space-5);
    }

    .theme-story:nth-child(2) :global(.media-placeholder) {
      aspect-ratio: 3 / 4;
    }

    .theme-story:last-child :global(.media-placeholder) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
