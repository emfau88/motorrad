---
import ButtonLink from "../components/ButtonLink.astro";
import PageHero from "../components/PageHero.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatEventDate } from "../utils/dates";
---

<BaseLayout
  title="50 Jahre OMF"
  description="Das Jubiläumsjahr der Ottenauer Motorradfreunde."
  noIndex={true}
>
  <PageHero
    eyebrow="Jubiläum 2026"
    title="50 Jahre OMF"
    intro="2026 feiern die Ottenauer Motorradfreunde ihr 50-jähriges Bestehen. Die ausführliche Jubiläumsseite entsteht im nächsten Projektblock."
    imageLabel="50 Jahre OMF"
    imageDescription="Historisches Jubiläumsfoto folgt"
  />
  <section class="anniversary section">
    <div class="container">
      <p class="eyebrow">Vormerken</p>
      <h2>{formatEventDate(siteConfig.anniversary)}</h2>
      <p>
        {siteConfig.anniversary.label} · {siteConfig.anniversary.location}
      </p>
      <ButtonLink href="/termine" variant="secondary">
        Zum Termin
      </ButtonLink>
    </div>
  </section>
</BaseLayout>

<style>
  .anniversary {
    min-height: 35svh;
    background: var(--color-paper-bright);
  }
  h2 {
    margin: var(--space-2) 0;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .anniversary p:not(.eyebrow) {
    margin: 0 0 var(--space-5);
    color: var(--color-muted);
  }
</style>
